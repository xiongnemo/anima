# dining_philosophers_safe.anm — SWEN90004 Asymmetric Deadlock-Free Solution

machine Fork:
    state Free:
        on get -> Taken
    state Taken:
        on put -> Free

machine Philosopher:
    state Thinking:
        on left.get -> HoldLeft
    state HoldLeft:
        on right.get -> Eating
    state Eating:
        on left.put -> PutRight
    state PutRight:
        on right.put -> Thinking

machine AsymmetricPhilosopher:
    state Thinking:
        on right.get -> HoldRight
    state HoldRight:
        on left.get -> Eating
    state Eating:
        on right.put -> PutLeft
    state PutLeft:
        on left.put -> Thinking

progress P0Eats = {p0.get}
progress P1Eats = {p1.get}

system SafeDiners:
    compose:
        f0: Fork
        f1: Fork
        p0: Philosopher(left=f0, right=f1)
        p1: AsymmetricPhilosopher(left=f1, right=f0)
    check:
        deadlock_free
        satisfies P0Eats
        satisfies P1Eats

def main() -> int:
    print("SafeDiners verified: asymmetric lock ordering eliminates circular wait")
    return 0
