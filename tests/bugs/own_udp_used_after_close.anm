import std.socket as sock
import std.bytes as bytes

def main() -> int:
    match sock.bind_udp("127.0.0.1", 0):
        Ok(s) ->
            s.close()
            match s.send_to(bytes.u8(1), "127.0.0.1", 9):
                Ok(n) -> print(n)
                Err(e) -> print(e)
        Err(e) -> print(e)
    return 0
