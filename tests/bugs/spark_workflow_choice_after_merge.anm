# A step that a merge goes on to by the choice written after it is proved
# like any other: fin is come to with n == 0 and divides by it.
workflow Find(k: int[0..9]) -> int:
    verify: sound

    start -> one:
        heard = k > 3

    choice after one:
        when heard -> a
        when not heard -> b

    step a -> both:
        n = 1
    step b -> both:
        n = 0

    merge both after a, b
    choice after both:
        when k > 0 -> fin
        when k <= 0 -> none

    step fin -> done:
        return 10 / n
    step none -> done:
        return 7

def main() -> int:
    print(run_workflow Find(1))
    print(run_workflow Find(9))
    return 0
