import std.socket as sock

def wait(t: int) -> int:
    match sock.listen_tcp("127.0.0.1", 0):
        Ok(ln) ->
            match ln.accept(timeout_ms=t):
                Ok(c) -> c.close()
                Err(e) -> print(e)
            ln.close()
        Err(e) -> print(e)
    return 0

def main() -> int:
    return wait(0)
