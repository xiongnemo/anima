# The loop assigns ys, so its length is no longer known after it, and an
# index into a list of unknown length was not checked at all: ys[1] is out
# of range and the function, declared to return an int, returned None.
# The same held for a list written by a pattern (g).
def f(xs: list[int]) -> int:
    ys = [1, 2]
    for x in xs:
        ys = [1]
    return ys[1]

def g(o: Option[list[int]]) -> int:
    ys = [1, 2]
    r = match o:
        Some(ys) -> 0
        None -> 0
    return ys[1]

def main() -> int:
    print(f([1]))
    print(g(Some([1])))
    return 0
