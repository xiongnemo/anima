# After the if, b was read as a boolean, the type of its last assignment:
# the kernel took one of the two comparisons for true and the division for
# unreachable. When c is false b still holds 0, equal to neither.
def h(c: bool) -> int:
    b = 0
    if c:
        b = True
    if b == True:
        return 1
    if b == False:
        return 2
    return 10 / 0

def main() -> int:
    print(h(False))
    return 0
