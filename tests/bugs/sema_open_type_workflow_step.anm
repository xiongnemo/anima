# o is None at the start and Some(0) after the step yes; fin reads it as an
# Option[int[1..9]]. All three kernels passed and both backends divided by
# zero.
workflow W(n: int) -> int:
    verify: sound

    start -> a:
        o = None
        ok = n > 0

    choice after a:
        when ok -> yes
        when not ok -> no

    step yes -> fin:
        o = Some(0)
    step no -> fin:
        print("no")

    step fin -> done:
        p: Option[int[1..9]] = o
        match p:
            Some(d) -> return 10 / d
            None -> return 1

def main() -> int:
    print(run_workflow W(1))
    return 0
