# x = 0 made x a plain int for the code after it only: the inner loop,
# which comes first, still took x for 1..9 on the second pass of the outer.
def f(xs: list[int[1..9]], k: int, m: int) -> int:
    t = 0
    for x in xs:
        a = 0
        while a < k:
            b = 0
            while b < m:
                x += 0
                b += 1
            t = 10 / x
            x = 0
            a += 1
    return t

def main() -> int:
    ys: list[int[1..9]] = [3]
    print(f(ys, 2, 0))
    return 0
