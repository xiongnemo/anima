# A variable passed as `mut` may not be used elsewhere in the same
# statement: whether `box.v` is read before or after `reset` changes it
# would decide the result. The call belongs in a statement of its own.

entity Box:
    v: int[0..10]

def reset(mut box: Box) -> int[1..1]:
    box.v = 0
    return 1

def main() -> int:
    box = Box(v=5)
    total = box.v + reset(mut box)
    print(total)
    return 0
