# The model of a workflow lost the action of a step that goes on by the
# choice written after it: `probe` was forbidden here and done all the same.
property NeverProbes:
    state Quiet:
        on left -> Quiet
        on right -> Quiet
        on probe -> ERROR

workflow Find(k: int[0..9]):
    verify: sound

    start -> probe

    step probe:
        heard = k > 3
    choice after probe:
        when heard -> left
        when not heard -> right

    step left -> done:
        print("left")
    step right -> done:
        print("right")

system Probing:
    compose:
        find: Find
    check:
        satisfies NeverProbes

def main() -> int:
    run_workflow Find(1)
    run_workflow Find(9)
    return 0
