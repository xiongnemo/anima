# The model of a workflow left out the action of a join that goes on by the
# choice written after it: `join_both` was forbidden here and done all the same.
property NeverJoins:
    state Open:
        on a -> Open
        on b -> Open
        on join_both -> ERROR

def note() -> int:
    return 1

workflow Find(k: int[0..9]) -> int:
    verify: sound

    start -> split

    fork split:
        branch left:
            call note()
        branch right:
            call note()

    join both
    choice after both:
        when k > 3 -> a
        when k <= 3 -> b

    step a -> done:
        return 1
    step b -> done:
        return 0

system Probing:
    compose:
        find: Find
    check:
        satisfies NeverJoins

def main() -> int:
    print(run_workflow Find(1))
    print(run_workflow Find(9))
    return 0
