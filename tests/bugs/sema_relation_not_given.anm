# BUG (sema soundness): a relation was read as the entity it names and
# never had to be given. o.buyer held no value, o.buyer.b was 0, and this
# divided by zero on both backends.
entity A:
    b: int[1..9]

entity O:
    amount: int
    rel buyer -> 1 A

def main() -> int:
    o = O(amount=1)
    print(10 / o.buyer.b)
    return 0
