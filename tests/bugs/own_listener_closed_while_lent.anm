import std.socket as sock
import std.concurrent as conc

def accept_one(ln: sock.TcpListener) -> int:
    match ln.accept(timeout_ms=100):
        Ok(conn) -> conn.close()
        Err(e) -> print(e)
    return 0

# The worker may still be inside accept() when the listener is closed.
def serve(pool: conc.ThreadPool) -> Result[int, str]:
    ln = sock.listen_tcp("127.0.0.1", 0)?
    fut = pool.submit(() => accept_one(ln))
    ln.close()
    _ = fut.await()
    return Ok(0)
