# The paths out of the choice written after a merge are followed like any
# other: only the path through yes shuts the pool down.
import std.concurrent as conc

workflow W(n: int) -> int:
    verify: sound

    start -> a:
        ok = n > 0
        pool = conc.ThreadPool(1, 2)

    step a -> both:
        print("a")
    merge both after a
    choice after both:
        when ok -> yes
        when not ok -> no

    step yes -> done:
        pool.shutdown()
        return 1
    step no -> done:
        return 2

def main() -> int:
    print(run_workflow W(0), run_workflow W(5))
    return 0
