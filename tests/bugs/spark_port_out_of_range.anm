# A port is a number of 16 bits. The native runtime cut 70000 down to 4464
# and listened there; the VM gave an Err. Both now give the Err, and the
# kernel refuses the call: port_bounds.
import std.socket as sock

def serve(port: int) -> int:
    match sock.listen_tcp("127.0.0.1", port):
        Ok(ln) ->
            print(ln.port())
            ln.close()
        Err(e) -> print(e)
    return 0

def main() -> int:
    return serve(70000)
